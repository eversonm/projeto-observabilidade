{
  "annotations": {"list": []},
  "editable": true,
  "panels": [
    {"id": 1, "title": "Disponibilidade da API", "type": "stat", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "min(probe_success{job=\"api-readiness\"})", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []}},
    {"id": 2, "title": "Uso de CPU do host", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))", "legendFormat": "CPU %", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}},
    {"id": 3, "title": "Uso de memória do host", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)", "legendFormat": "Memória %", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}},
    {"id": 4, "title": "Latência p95 por rota", "type": "timeseries", "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by(le, route) (rate(products_http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{route}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 5, "title": "Erros HTTP por minuto", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 0, "y": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(status_class) (rate(products_http_requests_total{status_class=~\"4xx|5xx\"}[1m])) * 60", "legendFormat": "{{status_class}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []}},
    {"id": 6, "title": "Requisições por segundo", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 8, "y": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(route) (rate(products_http_requests_total[5m]))", "legendFormat": "{{route}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 7, "title": "Tempo médio de resposta", "type": "timeseries", "gridPos": {"h": 7, "w": 8, "x": 16, "y": 7}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum(rate(products_http_request_duration_seconds_sum[5m])) / sum(rate(products_http_request_duration_seconds_count[5m]))", "legendFormat": "média", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 8, "title": "Rotas mais lentas (p95)", "type": "table", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "topk(10, histogram_quantile(0.95, sum by(le, route) (rate(products_http_request_duration_seconds_bucket[5m]))))", "format": "table", "instant": true, "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 9, "title": "MTTR por alerta", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "sum by(alert_name) (rate(products_incident_recovery_duration_seconds_sum[7d])) / sum by(alert_name) (rate(products_incident_recovery_duration_seconds_count[7d]))", "legendFormat": "{{alert_name}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 10, "title": "Uso de disco", "type": "timeseries", "gridPos": {"h": 7, "w": 12, "x": 0, "y": 22}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []}},
    {"id": 11, "title": "PostgreSQL: conexões", "type": "timeseries", "gridPos": {"h": 7, "w": 12, "x": 12, "y": 22}, "datasource": {"type": "prometheus", "uid": "prometheus"}, "targets": [{"expr": "pg_stat_activity_count", "legendFormat": "conexões", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}}
  ],
